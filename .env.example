# ==============================================================
# VESTIBULAR GPS — environment variables
#
# THERE ARE NONE, AND THAT IS THE POINT.
#
# This application has no backend, no API keys, no analytics and no
# secrets. Every sensor read, every computation and every stored session
# happens in the visitor's own browser. Nothing is uploaded.
#
# This file exists to make that explicit rather than leaving you to
# wonder whether a key is missing.
#
# If you fork this and add a service, put its credentials HERE and load
# them server-side. Never inline a key into a client bundle: anything in
# a static build is public, no matter how it is obfuscated.
#
# --------------------------------------------------------------
# Hypothetical additions, deliberately left empty:
# --------------------------------------------------------------
#
# AI_API_KEY=            # if you add an assistant, proxy it server-side
# SPACE_WEATHER_API_KEY= # public space-weather feeds need no key
# DATABASE_URL=          # a server-side store, never exposed to the client
# ANALYTICS_KEY=         # prefer a privacy-respecting, cookieless option
#
# --------------------------------------------------------------
# If you add a bridge process for real instruments (see docs/SENSOR_API.md),
# its configuration belongs to that process, not to this bundle.
# --------------------------------------------------------------
